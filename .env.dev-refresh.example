# Connection settings for the Production -> Development order data refresh (scripts/dev-refresh).
# Copy this file to ".env.dev-refresh" (git-ignored) and fill it in. Never commit the copy.
#
# Use the "Session pooler" or "Direct connection" string from each Supabase project (Project Settings -> Database).
# The tool refuses to run unless each string names the project its slot says: Production below must be project
# qaagfafagdpgzcijnfbw, Development must be project srxunxiytojjsuhcmzjg.
#
# Production is only ever READ: the session is opened read-only and the tool proves a write is refused before it uses it.

DEV_REFRESH_PROD_DB_URL=postgresql://postgres.qaagfafagdpgzcijnfbw:YOUR-PRODUCTION-DB-PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres
DEV_REFRESH_DEV_DB_URL=postgresql://postgres.srxunxiytojjsuhcmzjg:YOUR-DEVELOPMENT-DB-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Only for "media-copy --execute" (additive copy of missing evidence files into Development).
# Use the Production key ONLY to download; the tool never uploads to, changes or deletes anything in Production Storage.
# DEV_REFRESH_PROD_API_URL=https://qaagfafagdpgzcijnfbw.supabase.co
# DEV_REFRESH_PROD_SERVICE_KEY=
# DEV_REFRESH_DEV_API_URL=https://srxunxiytojjsuhcmzjg.supabase.co
# DEV_REFRESH_DEV_SERVICE_KEY=
